# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.
#
# application.properties defaults to PostgreSQL with placeholder credentials.
# Copy this file to .env and replace the placeholders below with your real values.

# ===== PostgreSQL (local dev override) =====
DB_URL=jdbc:postgresql://localhost:5432/contacts?sslmode=disable
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_DRIVER=org.postgresql.Driver
HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# ===== JWT =====
# Generate a secret: openssl rand -base64 32
JWT_SECRET=change-this-to-a-long-random-base64-string
